# 의존성
node_modules/

# 빌드 산출물
# out/ 은 electron-vite, release/ 는 electron-builder. build/ 는 아이콘 원본이라 추적한다.
out/
dist/
release/
*.tsbuildinfo
.vite/

# 패키징 결과물 (release/ 밖으로 떨어지는 경우까지)
*.dmg
*.zip
*.blockmap

# 로컬 전용 상태 — 에이전트 도구가 이 PC 에 만드는 것들
# 이 앱은 dmg 로 설치해 쓰고 소스를 받아 가는 사람이 없다. 따라서 .claude/ 를 공유할 이유가 없어 통째로 막는다
# (이 PC 의 권한 설정 settings.local.json, 다음 세션이 읽고 버리는 인계 메모 HANDOFF-*.md).
.omc/
.claude/

# 검증 찌꺼기
coverage/
tmp/
.tmp/

# 비밀값
.env
.env.local
.env.*.local

# 로그
*.log
npm-debug.log*
yarn-error.log*

# macOS
.DS_Store
._*

# 편집기
.vscode/
.idea/
*.swp
*~

# 디자인
*.pen

# e2e 가 만들어 쓰는 것들 — 스크립트만 추적한다
e2e/userdata/
e2e/userdata-*/
e2e/repo/
e2e/claude-home/
e2e/*.png
e2e/*.log

# 이 PC 에서만 쓰는 작업 도구. 저장소에 올리지 않는다.
.sudal/
